{
  "name": "devpilotx",
  "productName": "DevPilotX",
  "private": true,
  "version": "0.1.0",
  "description": "DevPilotX — an AI-driven IDE that acts as a virtual full-stack developer.",
  "author": "ViswaTeja7 <silverknight.viswateja@gmail.com>",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx server/server.ts",
    "build:renderer": "vite build web",
    "build:server": "esbuild server/server.ts --bundle --platform=node --format=cjs --sourcemap --outfile=dist/server.bundle.cjs --external:vite --external:node-pty",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --outdir=dist-electron --out-extension:.js=.cjs --external:electron",
    "build": "npm run build:renderer && npm run build:server && npm run build:electron",
    "start": "node dist/server.bundle.cjs",
    "electron": "npm run build && electron .",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:win:msi": "npm run build && electron-builder --win msi",
    "package:publish": "npm run build && electron-builder --publish always",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json",
    "lint:eslint": "eslint .",
    "format": "prettier --write \"web/src/**/*.{ts,tsx,css}\" \"web/*.ts\" \"electron/**/*.ts\" \"*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"web/src/**/*.{ts,tsx,css}\" \"web/*.ts\" \"electron/**/*.ts\" \"*.{ts,js,json,md}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "sbom": "npm sbom --sbom-format cyclonedx",
    "clean": "rm -rf dist dist-electron release"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "dotenv": "^17.2.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "i18next": "^26.4.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-pty": "^1.1.0",
    "openai": "^7.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^17.0.15",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@xterm/addon-web-links": "^0.12.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.2.3",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "com.devpilotx.ide",
    "productName": "DevPilotX",
    "publish": [
      {
        "provider": "github",
        "owner": "ViswaTeja7",
        "repo": "DevPioltxIde",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "package.json",
      "node_modules/node-pty/**/*"
    ],
    "asarUnpack": [
      "dist/**/*",
      "node_modules/node-pty/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  }
}
